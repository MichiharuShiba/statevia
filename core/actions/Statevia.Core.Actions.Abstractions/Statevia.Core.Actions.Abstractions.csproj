<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Statevia.Core.Actions.Abstractions</RootNamespace>
    <AssemblyName>Statevia.Core.Actions.Abstractions</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SonarScanner for .NET: SDK 形式は既定 GUID を持たない。sln 外の ProjectReference で 00000000 重複警告になるのを防ぐ。 -->
    <ProjectGuid>{3CF52601-1840-46C5-9D0F-142CE6EAFE05}</ProjectGuid>
    <!-- API スキャン以外では Sonar の protobuf を出さない（build/SonarQube.ComponentScope.props）。 -->
    <StateviaSonarComponent>api</StateviaSonarComponent>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\SonarQube.ComponentScope.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <ProjectReference Include="..\..\engine\Statevia.Core.Engine\Statevia.Core.Engine.csproj" />
  </ItemGroup>

</Project>
